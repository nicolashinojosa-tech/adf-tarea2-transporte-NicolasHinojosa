{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = 'V-' + lpad(regexReplace(VehiculoId, '[^0-9]', ''), 3, '0'),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          CapacidadEfectiva = toInteger(trim(CapacidadEfectiva)),",
				"          VigenciaDesde = iif(locate('/', VigenciaDesde) > 0, toDate(VigenciaDesde, 'dd/MM/yyyy'), toDate(VigenciaDesde, 'yyyy-MM-dd')),",
				"          VigenciaHasta = iif(locate('/', VigenciaHasta) > 0, toDate(VigenciaHasta, 'dd/MM/yyyy'), toDate(VigenciaHasta, 'yyyy-MM-dd')),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(VehiculoId),",
				"     Placa = first(Placa),",
				"          TipoVehiculo = first(TipoVehiculo),",
				"          CapacidadEfectiva = first(CapacidadEfectiva),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}