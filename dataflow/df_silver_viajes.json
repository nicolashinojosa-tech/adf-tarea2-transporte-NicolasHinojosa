{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = trim(ViajeId),",
				"          RutaHistoricaId = 'R-' + lpad(regexReplace(RutaHistoricaId, '[^0-9]', ''), 2, '0'),",
				"          VehiculoId = 'V-' + lpad(regexReplace(VehiculoId, '[^0-9]', ''), 3, '0'),",
				"          FechaServicio = iif(locate('/', FechaServicio) > 0, toDate(FechaServicio, 'dd/MM/yyyy'), toDate(FechaServicio, 'yyyy-MM-dd')),",
				"          HoraProgramada = trim(HoraProgramada),",
				"          HoraSalida = trim(HoraSalida),",
				"          HoraLlegada = trim(HoraLlegada),",
				"          ValidacionesTarjeta = toInteger(iif(isNull(ValidacionesTarjeta) || trim(ValidacionesTarjeta) == 'NULL' || trim(ValidacionesTarjeta) == '', '0', trim(ValidacionesTarjeta))),",
				"          KmRecorridos = toDecimal(replace(trim(KmRecorridos), ',', '.'), 8, 1),",
				"          EstadoViaje = upper(trim(EstadoViaje))) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(ViajeId),",
				"     RutaHistoricaId = first(RutaHistoricaId),",
				"          VehiculoId = first(VehiculoId),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje)) ~> aggregate1",
				"aggregate1 derive(HoraProgramada = iif(     startsWith(HoraProgramada, '1900-'),     toTimestamp(HoraProgramada, 'yyyy-MM-dd HH:mm:ss'),     toTimestamp('1900-01-01 ' + trim(HoraProgramada), 'yyyy-MM-dd HH:mm') ),",
				"          HoraSalida = iif(     startsWith(HoraSalida, '1900-'),     toTimestamp(HoraSalida, 'yyyy-MM-dd HH:mm:ss'),     toTimestamp('1900-01-01 ' + trim(HoraSalida), 'yyyy-MM-dd HH:mm') ),",
				"          HoraLlegada = iif(     startsWith(HoraLlegada, '1900-'),     toTimestamp(HoraLlegada, 'yyyy-MM-dd HH:mm:ss'),     toTimestamp('1900-01-01 ' + trim(HoraLlegada), 'yyyy-MM-dd HH:mm') )) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}