{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(replace(trim(TipoIncidente), '_', ' ')),",
				"          Severidad = upper(trim(Severidad)),",
				"          FechaHoraInicio = iif(locate('/', FechaHoraInicio) > 0, toTimestamp(FechaHoraInicio, 'dd/MM/yyyy'), toTimestamp(FechaHoraInicio, 'yyyy-MM-dd')),",
				"          FechaHoraFin = iif(locate('/', FechaHoraFin) > 0, toTimestamp(FechaHoraFin, 'dd/MM/yyyy'), toTimestamp(FechaHoraFin, 'yyyy-MM-dd')),",
				"          FechaHoraRegistro = iif(locate('/', FechaHoraRegistro) > 0, toTimestamp(FechaHoraRegistro, 'dd/MM/yyyy'), toTimestamp(FechaHoraRegistro, 'yyyy-MM-dd')),",
				"          VehiculoId = iif(isNull(VehiculoId) || upper(trim(VehiculoId)) == 'NULL' || trim(VehiculoId) == '', toString(null()), trim(VehiculoId)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}